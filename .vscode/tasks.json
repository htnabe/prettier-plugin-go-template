{
  // See https://go.microsoft.com/fwlink/?LinkId=733558
  // for the documentation about the tasks.json format
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run current file",
      "command": "bun run ts-node ${relativeFile}",
      "type": "shell",
      "problemMatcher": []
    },
    {
      "type": "shell",
      "label": "build",
      "command": "bun run build",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "type": "shell",
      "label": "format",
      "command": "bun run format",
      "problemMatcher": []
    },
    {
      "type": "shell",
      "label": "coverage",
      "command": "bun run coverage",
      "problemMatcher": []
    },
    {
      "type": "shell",
      "label": "test",
      "command": "bun run test",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "type": "shell",
      "label": "lint",
      "command": "bun run lint",
      "problemMatcher": []
    },
    {
      "type": "shell",
      "label": "lint:fix",
      "command": "bun run lint:fix",
      "problemMatcher": []
    }
  ]
}
