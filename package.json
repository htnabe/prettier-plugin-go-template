{
  "name": "@htnabe/prettier-plugin-go-template",
  "version": "0.0.5",
  "description": "Prettier plugin for formatting Go & GoHugo templates.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/htnabe/prettier-plugin-go-template"
  },
  "author": {
    "name": "htnabe"
  },
  "keywords": [
    "prettier",
    "plugin",
    "go",
    "hugo",
    "gohugo",
    "template",
    "html"
  ],
  "type": "module",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "update:deps": "ncu -u && npm install",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "test:runtime": "npm run build && node -e \"import('./dist/index.mjs')\"",
    "release:coverage": "npm run coverage",
    "release:plugin": "npm run test:runtime && npm run release:coverage && npm publish --access public",
    "build": "tsdown",
    "build:watch": "tsdown --watch"
  },
  "peerDependencies": {
    "prettier": "^3.0.0"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "codecov": "^3.8.3",
    "lefthook": "^2.2.1",
    "npm-check-updates": "^23.1.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2003",
    "prettier": "^3.9.9",
    "ts-node": "^10.9.2",
    "tsdown": "^0.23.0",
    "tslib": "^2.8.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "ulid": "^3.0.2"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  }
}
